# Copiez ce fichier en .env puis changez les valeurs : cp .env.example .env
# Sans .env, le projet démarre quand même avec des valeurs de développement.

# --- Base de données MySQL ---
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=jobaggregator
MYSQL_USER=jobaggregator
MYSQL_PASSWORD=change-me-db

# --- Sécurité ---
# Clé de signature des jetons de connexion. Générez-en une : openssl rand -base64 48
# Vide = clé aléatoire à chaque démarrage (les utilisateurs devront se reconnecter).
JWT_SECRET=

# Durée de validité d'une session (minutes) et limite de tentatives de connexion par IP.
JWT_EXPIRE_MINUTES=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=600

# Compte administrateur créé au démarrage (laisser vide pour n'en créer aucun).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin

# --- Collecte des offres ---
# Clé de l'API WeLoveDevs (réservée aux adresses @epitech.eu : https://epi-api.welovedevs.com/ask-for-api-key/).
# Sans clé, la collecte est désactivée et des offres de démonstration sont chargées.
WELOVEDEVS_API_KEY=
COLLECT_INTERVAL_MINUTES=30
# auto = offres de démo si la base est vide et sans clé ; never = jamais
DEMO_DATA=auto

# --- IA ---
# true = télécharge et charge le modèle (~470 Mo) dès le démarrage, en arrière-plan.
WARMUP_MODEL=true

# --- Front-end ---
CORS_ORIGINS=http://localhost:8082
